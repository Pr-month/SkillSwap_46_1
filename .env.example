# Сервер
APP_PORT=3000
HASH_SALT=$(openssl rand -hex 32)

# JWT
JWT_ACCESS_SECRET=$(openssl rand -hex 32)
JWT_REFRESH_SECRET=$(openssl rand -hex 32)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# База данных (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_NAME=skillswap
DB_SYNCHRONIZE=true

# Логирование
LOGGER_TYPE=dev
